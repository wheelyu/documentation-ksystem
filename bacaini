	   Contoh:
	   LOCAL
	   PGM_FIELDS
	   lsql_log	STRING          1000

	   DEFAULTS(master)
	   lsql_log     INIT    	"
		   SELECT *
	   FROM ( SELECT log.logtgl, log.logusr, log.logscr, log.logfile,

	   COUNT(CASE WHEN (log.logfile ='ppm' AND ppm.ppmsts = 'OPEN') THEN ppm.ppmnobuk 
	         WHEN (log.logfile ='tlm' AND tlm.tlmsts = 'OPEN') THEN tlm.tlmnobuk ELSE NULL END) AS ljml_O,
	   COUNT(CASE WHEN (log.logfile ='ppm' AND ppm.ppmsts = 'INPG') THEN ppm.ppmnobuk 
	         WHEN (log.logfile ='tlm' AND tlm.tlmsts = 'INPG') THEN tlm.tlmnobuk ELSE NULL END) AS ljml_I,
	   COUNT(CASE WHEN (log.logfile ='ppm' AND ppm.ppmsts = 'CLSD') THEN ppm.ppmnobuk 
	         WHEN (log.logfile ='tlm' AND tlm.tlmsts = 'CLSD') THEN tlm.tlmnobuk ELSE NULL END) AS ljml_C,
	   COUNT(CASE WHEN (log.logfile ='ppm' AND ppm.ppmsts <> 'OPEN' AND ppm.ppmsts <> 'INPG'AND ppm.ppmsts <> 'CLSD') THEN ppm.ppmnobuk 
	         WHEN (log.logfile ='tlm'  AND tlm.tlmsts <> 'OPEN' AND tlm.tlmsts <> 'INPG'AND tlm.tlmsts <> 'CLSD') THEN tlm.tlmnobuk ELSE NULL END) AS ljml_L,

	   SUM(CASE WHEN (log.logfile ='ppm' AND ppm.ppmsts = 'OPEN') THEN ppm.ppmtotfak 
	         WHEN (log.logfile ='tlm' AND tlm.tlmsts = 'OPEN') THEN tlm.tlmtotal ELSE 0 END) AS ltot_O,
	   SUM(CASE WHEN (log.logfile ='ppm' AND ppm.ppmsts = 'INPG') THEN ppm.ppmtotfak 
	         WHEN (log.logfile ='tlm' AND tlm.tlmsts = 'INPG') THEN tlm.tlmtotal ELSE 0 END) AS ltot_I,
	   SUM(CASE WHEN (log.logfile ='ppm' AND ppm.ppmsts = 'CLSD') THEN ppm.ppmtotfak 
	         WHEN (log.logfile ='tlm' AND tlm.tlmsts = 'CLSD') THEN tlm.tlmtotal ELSE 0 END) AS ltot_C,
	   SUM(CASE WHEN (log.logfile ='ppm' AND ppm.ppmsts <> 'OPEN' AND ppm.ppmsts <> 'INPG'AND ppm.ppmsts <> 'CLSD') THEN ppm.ppmtotfak
	         WHEN (log.logfile ='tlm'  AND tlm.tlmsts <> 'OPEN' AND tlm.tlmsts <> 'INPG'AND tlm.tlmsts <> 'CLSD') THEN tlm.tlmtotal ELSE NULL END) AS ltot_L

	   FROM log
	   LEFT JOIN ppm ON log.logfile = 'ppm' AND ppm.ppmnobuk = log.lognobuk
	   LEFT JOIN tlm ON log.logfile = 'tlm' AND tlm.tlmnobuk = log.lognobuk

	   WHERE 
	   log.logtgl = '2024-12-02' AND log.logusr = 'AMEL' AND log.logtype = 'A'

	   GROUP BY
	   log.logtgl,
	   log.logusr,
	   log.logscr,
	   log.logfile
	   ) AS subquery
	   WHERE (ljml_O + ljml_I + ljml_C + ltot_O + ltot_I + ltot_C) <> 0 

