MAP(misinippanelis)
lnippansblm lnippansblm     REPLACE_IF cjointldjwlpan
lnippansblm psdstr1     REPLACE

HOOKS(tmptranst)
AFTER_INPUT     cur_field=psdtype       DO_MAP SHOW misinourtpan
AFTER_INPUT     cur_field=psdtype      DO_MAP SHOW misinippanelis


SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
