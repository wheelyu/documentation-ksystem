MAP(mscanpsdubhpan)
c1      ltotubhpan      DO_CALC

DBCALCS(dbscanpsdubhpan)
        DBC_COMMAND     SCANSCAN
        DBC_TARGET      psddatpsmurt   lUBHPAN1030 tlmnobuk
        DBC_SUM_MAP     mscanpsdubhpan


CALCS()
cpsdkodepan STRIP(tlmnobuk) + FLD_TO_STRING(ltotubhpan)
cscanpsdubhpan  dbscanpsdubhpan!=0 || dbscanpsdubhpan==0
cjointldjwlpan djointldjwlpan==1

EDITS(tmptranst)
t.ValidateNip   psdstr2 VALIDATE psikodidx mpsiinppnl 0

MAP(mpsiinppnl)
psikode         psdstr2         REPLACE

MAP(misinourtpan)
ltotubhpan  ltotubhpan  REPLACE_IF cscanpsdubhpan
ltotubhpan  psdnourt    REPLACE
