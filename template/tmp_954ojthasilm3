IMAGE(tmptrans)

FIELD(tmptranst)
tldjml  	PROTECT			INPUTRI 	1
lketlulus       PROTECT                 INPUTRI         2
tldnobbm        ALLCAPS                 INPUTRI         3  
tldstr4         PROTECT                 INPUTRI         4 
tldket          TEXTAREA                INPUTRI         5

tldhrg          PROTECT			INPUTRI 	6
lketlulus1      PROTECT			INPUTRI 	7
tldnoll         ALLCAPS                 INPUTRI         8 
tldstr5         ALLCAPS                 INPUTRI         9 
tldket2         TEXTAREA                INPUTRI         10

lenter          NOCHANGE                INPUTRI         11

CALCS()
ctipeb          tldukrwrn == "TANDEM" && tldgrup2 == "TIPEB"

DBCALCS(djointldhsltandem)
        DBC_COMMAND     JOIN
        DBC_TARGET      tldstsbrgukr   lHSLOJTMGA  gv_CLSD tlmnobuk 
        DBC_SELECT      ctipeb

CALCS()
clebih375_1             djointldhsltandem == 1 && tldjml >= 3.75
clebih375NO_1           djointldhsltandem == 1 && tldhrg >= 3.75 && tldtydis == "NO"
clebih375YES_1          djointldhsltandem == 1 && tldjml >= 3.75 && tldtydis == "YES"

clebih375_0             djointldhsltandem == 0 && tldjml >= 3.75
clebih375NO_0           djointldhsltandem == 0 && tldhrg >= 3.75 && tldtydis == "NO"
clebih375YES_0          djointldhsltandem == 0 && tldjml >= 3.75 && tldtydis == "YES"


DEFAULT(tmptranst)
/*PILIHAN SPV TIPE REMED*/
IF ckurang375           tldnobbm         DFALT_SCAN             TIDAK_LULUS
IF clebih375_1          tldnobbm         DFALT_SCAN             REMEDIAL
/*PILIHAN SPV BUKAN TIPE REMED*/
IF clebih375_0          tldnobbm         DFALT_SCAN             LULUS
                                                                REMEDIAL
/*PILIHAN AM*/
IF ckurang375NO         tldnoll          DFALT_SCAN             TIDAK_LULUS
IF clebih375NO_1        tldnoll          DFALT_SCAN             REMEDIAL
IF clebih375YES_1       tldnoll          DFALT_SCAN             REMEDIAL
                                                                TIDAK_LULUS
/*PILIHAN SPV BUKAN TIPE REMED*/
IF clebih375NO_0        tldnoll          DFALT_SCAN             LULUS
                                                                REMEDIAL

IF clebih375YES_0       tldnoll          DFALT_SCAN             LULUS
                                                                REMEDIAL
                                                                TIDAK_LULUS

                        

EDITS(tmptranst)
e.Mandatory     tldnobbm        MANDATORY_IF cSPVGADAI
e.Mandatory     tldket          MANDATORY_IF cSPVGADAI
e.Mandatory     tldnoll         MANDATORY_IF cAM
e.Mandatory     tldket2         MANDATORY_IF cAM

MAP(mketlulusM3)
cLULUS          lketlulus       DO_CALC
cTDK_LULUS      lketlulus       DO_CALC_IF ckurang375
cLULUS          lketlulus1      DO_CALC
cTDK_LULUS      lketlulus1      DO_CALC_IF ckurang375a

MAP(mketlulusM3a)
cLULUS          lketlulus       DO_CALC
cTDK_LULUS      lketlulus       DO_CALC_IF ckurang375
cLULUS          lketlulus1      DO_CALC
cTDK_LULUS      lketlulus1      DO_CALC_IF ckurang375a

HOOKS(tmptranst)
BEFORE_INPUT  cur_field=tldnobbm   DO_SKIP_IF cAM
BEFORE_INPUT  cur_field=tldket     DO_SKIP_IF cAM
BEFORE_INPUT  cur_field=tldnoll    DO_SKIP_IF cSPVGADAI
BEFORE_INPUT  cur_field=tldket2    DO_SKIP_IF cSPVGADAI

BEFORE_INPUT  cur_field=tldnobbm   DO_MAP SHOW mketlulusM3
BEFORE_INPUT  cur_field=tldnoll    DO_MAP SHOW mketlulusM3a

AFTER_INPUT     cur_field=tldket      DO_MAP SHOW mpanjangchar1
AFTER_INPUT     cur_field=tldket2     DO_MAP SHOW mpanjangchar1

AFTER_INPUT     cur_field=tldket      DO_MAP SHOW
                IF cmin50charSPV mdum
                ELSE HKCURSOR STAY
                HKMSG t.Minimal50Karakter

AFTER_INPUT     cur_field=tldket2      DO_MAP SHOW
                IF cmin50charAM mdum
                ELSE HKCURSOR STAY
                HKMSG t.Minimal50Karakter

AFTER_INPUT   cur_keybd=EN         DO_MAP SHOW misipenilai

SUBFILE(tmptrans)
        SFL_LINES(1)
        SFL_TITLE(tmptranst)
        SFL_TARGET
        tldstsbrgukr   lHSLOJTMGA gv_CLSD tlmnobuk lOJTPICM321          

