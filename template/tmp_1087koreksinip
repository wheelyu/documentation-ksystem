IMAGE(tmptrans)

FIELDS(tmptranst)
svistr1                 NOCHANGE                INPUTRI 1   /*Nip yang mau diubah*/
svistr2                 PROTECT                 INPUTRI 2   /*Nip pic awal*/
svistr3                 DIGITS                  INPUTRI 3   /*Nip pic rev*/
svistr4                 TEXTAREA 2              INPUTRI 4   /*Alasan pic diubah*/
svistr5                 PROTECT                 INPUTRI 5   /*Nip atasan awal*/
svistr6                 DIGITS                  INPUTRI 6   /*Nip atasan rev*/
svistr7                 TEXTAREA 2              INPUTRI 7   /*Alasan atasan diubah*/
svistr8                 PROTECT                 INPUTRI 8   /*Nip pdca awal*/
svistr9                 DIGITS                  INPUTRI 9   /*Nip pdca rev*/
svistr10                TEXTAREA 2              INPUTRI 10  /*Alasan pdca diubah*/
lenter                  ALLCAPS                 INPUTRI 99

DEFAULTS(tmptranst)
svistr1                 DFALT_SCAN_BLANKS
                                                PIC         "   "
                                                ATASAN      "   "
                                                PDCA        "   "
                                                PIC-ATASAN  "   "
                                                PIC-PDCA    "   "
                                                ATASAN-PDCA "   "
                                                ALL         "   "

CALCS()
cskippic                svistr1 == "ATASAN" || svistr1 == "PDCA" || svistr1 == "ATASAN-PDCA"
cskipatasan             svistr1 == "PIC" || svistr1 == "PDCA" || svistr1 == "PIC-PDCA"
cskippdca               svistr1 == "PIC" || svistr1 == "ATASAN" || svistr1 == "PIC-ATASAN"
cjikapic                svistr1 == "PIC" || svistr1 == "PIC-ATASAN" || svistr1 == "PIC-PDCA" || svistr1 == "ALL"
cjikaats                svistr1 == "ATASAN" || svistr1 == "PIC_ATASAN" || svistr1 == "ATASAN-PDCA" || svistr1 == "ALL"
cjikapdca               svistr1 == "PDCA" || svistr1 == "PIC-PDCA" || svistr1 == "ATASAN-PDCA" || svistr1 == "ALL"

EDITS(tmptranst)
t.Mandatory             svistr3                 VALIDATE_IF cjikapic    psikodidx 0 0
t.Mandatory             svistr6                 VALIDATE_IF cjikaats    psikodidx 0 0
t.Mandatory             svistr9                 VALIDATE_IF cjikapdca   psikodidx 0 0

MAP(mupdkoreksinip)
svistr3                 tkdjwbstr1              REPLACE_IF cjikapic
svistr6                 tkdrek                  REPLACE_IF cjikaats

MAP(mupdkoreksipdca)
svistr9                 tlmplg                  REPLACE_IF cjikapdca

SPCALCS(spkoreksinip)
DO_LIB                  ap_dbclc(DNAME dupdkoreksinip,DCOMMAND UPDATE,DTARGET tkdprmidx tkdprm,DMAP mupdkoreksinip);
DO_LIB                  ap_dbclc(DNAME dupdkoreksipdca,DCOMMAND UPDATE,DTARGET tlmbukidx tkdnobuk,DMAP mupdkoreksipdca);

HOOKS(tmptranst)
BEFORE_INPUT            cur_field=svistr3       DO_SKIP_IF cskippic
BEFORE_INPUT            cur_field=svistr4       DO_SKIP_IF cskippic
BEFORE_INPUT            cur_field=svistr6       DO_SKIP_IF cskipatasan
BEFORE_INPUT            cur_field=svistr7       DO_SKIP_IF cskipatasan
BEFORE_INPUT            cur_field=svistr9       DO_SKIP_IF cskippdca
BEFORE_INPUT            cur_field=svistr10      DO_SKIP_IF cskippdca

AFTER_INPUT             cur_keybd=EN            DO_SPCALCS spkoreksinip

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_SHOW_NEXT
SFL_TARGET	
        svidatbuktyp    lKORNIP tkdnoll

SFL_MAP
lKORNIP                 svidata                 REPLACE
tkdnoll                 svinobuk                REPLACE
tkdjwbstr1              svistr2                 REPLACE
tkdrek                  svistr5                 REPLACE
tlmplg_2                svistr8                 REPLACE
