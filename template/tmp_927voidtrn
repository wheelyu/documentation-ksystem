IMAGE(tmptrans)

FIELD(tmptranst)
psdpsmkode      PROTECT   		INPUTRI 1
psdstr2         PROTECT                 INPUTRI 2
psdstr3         PROTECT                 INPUTRI 3
psdtgl1		PROTECT	{DD-MM-YYYY}	INPUTRI	4
psdstr1		PROTECT			INPUTRI 5	
lnmvoid		PROTECT	ALLCAPS		INPUTRI 6
psdtype2	NOCHANGE			INPUTRI	7
psdket		TEXTAREA ALLCAPS	INPUTRI 8
ldum		ALLCAPS			INPUTRI	9


DEFAULTS(tmptranst)
psdstr1         INIT	        {g_usrkode}
psdtgl1			INIT			{g_tgltrn}
psdtype2		DFALT_SCAN_BLANKS	VOID    INPG

EDITS(tmptranst)
t.Validate 		psdstr1 	VALIDATE psikodidx mpsivoid 0
e.Mandatory     psdtype2	MANDATORY
e.Mandatory     psdket		MANDATORY

MAP(mpsivoid)
psikode		psdstr1		REPLACE
psinama		lnmvoid		REPLACE

MAP(mscanpsdvoid927)
gv_int1		lurut		REPLACE

DBCALCS(dscanpsdvoid927)
	DBC_COMMAND	SCANSCAN
	DBC_TARGET	psddatpsmkod tlmdata tlmnobuk lVOID927
	DBC_SUM_MAP	mscanpsdvoid927

CALCS()
cblhvoid      (g_grpnam == "RI" || g_grpnam=="TRAINDVH" || g_grpnam=="TRAINHEAD" || g_usrkode == "2580864" || g_usrkode == "2550257" || g_usrkode == "2670581" || g_usrkode == "2630765")
cscanpsdvoid	dscanpsdvoid927 >= 0
ckodevoid	"VOID927-" + FLD_TO_STRING(lurut)
ctambah		g_curcmd == 1
curut           lurut + 1

HOOKS(tmptranst)
BEFORE_INPUT	cur_field=psdtype2	DO_MAP SHOW murutf

MAP(murutf)
c0			lurut		DO_CALC
curut		lurut		DO_CALC_IF cscanpsdvoid
ckodevoid	psdtype	   	DO_CALC_IF ctambah
lurut		psdnourt	REPLACE_IF ctambah

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_COND cblhvoid
SFL_LINES(1)
SFL_TARGET
        psddatpsmkod tlmdata tlmnobuk lVOID927

SFL_MAP
tlmdata	        psddata         REPLACE
tlmnobuk        psdpsmkode	REPLACE
lVOID927        psdkode         REPLACE
tlmsts          psdstr2         REPLACE
tlmsts2         psdstr3         REPLACE