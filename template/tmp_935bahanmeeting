IMAGE(tmptrans)

FIELDS(tmptranst)
spknobuk                        PROTECT                         INPUTRI 1       /*Nobuk*/
spktglft                        PROTECT                         INPUTRI 2       /*Tgl Meeting*/
spkjam                          PROTECT                         INPUTRI 3       /*Jam Mulai*/
spkjam2	                        PROTECT                         INPUTRI 4       /*Jam Selesai*/
spkkat	                        PROTECT                         INPUTRI 5       /*Judul Meeting*/
spkket  	                PROTECT                         INPUTRI 6       /*Keterangan Meeting*/
spkkat2                         PROTECT                         INPUTRI 7       /*Tempat*/
spkkat3		                PROTECT                         INPUTRI 8       /*Divisi*/
spkkode                         PROTECT                         INPUTRI 9       /*NIP DEV*/
spknama                         PROTECT                         INPUTRI 10      /*Nama DEV*/

spkket2                         TEXTAREA                        INPUTRI 11      /*Link Drive*/
spkket3                         TEXTAREA                        INPUTRI 12      /*Keterangan*/
spkhasil                        PROTECT                         INPUTRI 13      /*Status Upload*/

spkkode2                        PROTECT                         INPUTRI 14      /*NIP Head Dev*/
spknama2                        PROTECT                         INPUTRI 15      /*Nama Head Dev*/
spktglft2                       PROTECT                         INPUTRI 16      /*Tanggal Approval*/
spktgg                          ALLCAPS                         INPUTRI 17      /*Approval Head Dev*/
spkjrk                          PROTECT                         INPUTRI 18      /*Tanda TACC*/
spkreview                       TEXTAREA                        INPUTRI 19      /*Keterangan Approval Head Dev*/

spkkode3                        PROTECT                         INPUTRI 20      /*NIP Head Opr*/
spknama3                        PROTECT                         INPUTRI 21      /*Nama Head Opr*/
spktglft3                       PROTECT                         INPUTRI 22      /*Tanggal Approval*/
spktgg2                         NOCHANGE                        INPUTRI 23      /*Approval Head Opr*/
spkjrk2                         PROTECT                         INPUTRI 24      /*Tanda TACC*/
spkreview2                      TEXTAREA                        INPUTRI 25      /*Keterangan Approval Head Opr*/

spkkode4                        PROTECT                         INPUTRI 26      /*NIP PDCA*/
spknama4                        PROTECT                         INPUTRI 27      /*Nama PDCA*/
spktglft4                       PROTECT                         INPUTRI 28      /*Tanggal Approval*/
spktgg3                         NOCHANGE                        INPUTRI 29      /*Approval PDCA*/
spkjrk3                         PROTECT                         INPUTRI 30      /*Tanda TACC*/
spkreview3                      TEXTAREA                        INPUTRI 31      /*Keterangan Approval PDCA*/

lenter                          NOCHANGE                        INPUTRI 33      /*enter*/

CALCS()
cbknnipdev                      g_grpnam != "RI" && g_grpnam != "RAS"
cbknnipheaddev                  g_usrkode != spkkode2
cbknnipheadopr                  g_usrkode != spkkode3
cbknnippdca                     g_usrkode != spkkode4
cloginnipheaddev                g_usrkode == spkkode2
cloginnipheadopr                g_usrkode == spkkode3
cloginnippdca                   g_usrkode == spkkode4
cdeldocbhnmeet                  tlmkodeapr != "APR_HEAD_DEV" && tlmkodeapr != "APR_HEAD_OPR" && tlmkodeapr != "APR_PDCA"
caprawlhdev                     spkjrk  == 0
caprawlhopr                     spkjrk2 == 0
caprawlpdca                     spkjrk3 == 0
ctacchdev                       spkjrk  == 1
ctacchopr                       spkjrk2 == 1
ctaccpdca                       spkjrk3 == 1
chituplbhn                      spkjmtgg  + 1
chitaprheaddev                  spkjmtgg2 + 1
chitaprheadopr                  spkjmtgg3 + 1
chitaprpdca                     spkjmtgg4 + 1

DEFAULTS(tmptranst)
lenter                          INIT_LABEL                      "Enter Disini"
IF caprawlhdev  spktgg          DFALT_SCAN_BLANKS               ACC
                                                                TACC

IF caprawlhopr  spktgg2         DFALT_SCAN_BLANKS               ACC
                                                                TACC

IF caprawlpdca  spktgg3         DFALT_SCAN_BLANKS               ACC
                                                                TACC

IF ctacchdev    spktgg          DFALT_SCAN_BLANKS               ACC
IF ctacchopr    spktgg2         DFALT_SCAN_BLANKS               ACC
IF ctaccpdca    spktgg3         DFALT_SCAN_BLANKS               ACC


EDITS(tmptranst)
e.Wajib isi Link Drive          spkket2         MANDATORY
e.Wajib isi Keterangan          spkket3         MANDATORY      

e.Validate Nip Dev              spkkode         VALIDATE psikodidx mpsidev 0
e.Validate Nip Head Dev         spkkode2        VALIDATE psikodidx mpsiheaddev 0
e.Validate Nip Head Opr         spkkode3        VALIDATE psikodidx mpsiheadopr 0
e.Validate Nip Pdca             spkkode4        VALIDATE psikodidx mpsipdca 0

MAP(mpsidev)
psikode         spkkode         REPLACE
psinama         spknama         REPLACE

MAP(mpsiheaddev)
psikode         spkkode2        REPLACE
psinama         spknama2        REPLACE

MAP(mpsiheadopr)
psikode         spkkode3        REPLACE
psinama         spknama3        REPLACE

MAP(mpsipdca)
psikode         spkkode4        REPLACE
psinama         spknama4        REPLACE

MAP(misibahanmeeting)
tlmnobuk        spknobuk        REPLACE
tlmtgl2         spktglft        REPLACE
tlmjam1         spkjam          REPLACE
tlmjam2         spkjam2	        REPLACE
tlmdari         spkkat	        REPLACE
tlmket          spkket          REPLACE
tlmuntuk        spkkat2         REPLACE
ldvs            spkkat3		REPLACE
lnipsendev      spkkode         REPLACE         /*NIP Dev*/
lnipheaddev     spkkode2        REPLACE         /*NIP HEad Dev*/
lnipheadopr     spkkode3        REPLACE         /*NIP Head Opr*/
lnippdcadir     spkkode4        REPLACE         /*NIP Pdca*/
DEBUG ldum      ldum            REPLACE         

MAP(misitglapproval)
g_tgltrn        spktglft2       REPLACE_IF cloginnipheaddev
chitaprheaddev  spkjmtgg2       DO_CALC_IF cloginnipheaddev
g_tgltrn        spktglft3       REPLACE_IF cloginnipheadopr
chitaprheadopr  spkjmtgg3       DO_CALC_IF cloginnipheadopr
g_tgltrn        spktglft4       REPLACE_IF cloginnippdca
chitaprpdca     spkjmtgg4       DO_CALC_IF cloginnippdca

HOOKS(tmptranst)   
BEFORE_INPUT                    cur_field=spkket2               DO_MAP SHOW misibahanmeeting 
BEFORE_INPUT                    cur_field=spkket2               DO_SKIP_IF cbknnipdev                                                                 
BEFORE_INPUT                    cur_field=spkket3               DO_SKIP_IF cbknnipdev  

BEFORE_INPUT                    cur_field=spktgg                DO_MAP SHOW misitglapproval                                                                 
BEFORE_INPUT                    cur_field=spktgg                DO_SKIP_IF cbknnipheaddev                                                                 
BEFORE_INPUT                    cur_field=spkreview             DO_SKIP_IF cbknnipheaddev   

BEFORE_INPUT                    cur_field=spktgg2               DO_MAP SHOW misitglapproval                                                                 
BEFORE_INPUT                    cur_field=spktgg2               DO_SKIP_IF cbknnipheadopr                                                                 
BEFORE_INPUT                    cur_field=spkreview2            DO_SKIP_IF cbknnipheadopr   

BEFORE_INPUT                    cur_field=spktgg3               DO_MAP SHOW misitglapproval                                                                 
BEFORE_INPUT                    cur_field=spktgg3               DO_SKIP_IF cbknnippdca                                                                 
BEFORE_INPUT                    cur_field=spkreview3            DO_SKIP_IF cbknnippdca 


MAP(mupduplbhnmeet)
lOK             spkhasil        REPLACE
g_tgltrn        spktglft5       REPLACE
chituplbhn      spkjmtgg        DO_CALC
DBCALCS(dupdbhnmeet)
        DBC_COMMAND             UPDATE
        DBC_TARGET              spkprmidx spkprm
        DBC_MAP                 mupduplbhnmeet


SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_SHOW_NEXT
SFL_UPL_DIRFLD          tlmtgl
SFL_DOCUPLFLD           spknobuk spkdata
SFL_DOCUPLFLD_DBCALCS   dupdbhnmeet    /*tanda upload*/
SFL_DOCUPL_DELCOND      cdeldocbhnmeet
