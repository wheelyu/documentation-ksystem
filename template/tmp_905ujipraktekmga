e.ValidateMerk  tkdjwbstr2  VALIDATE tbddatkodidx mtbdSin stbd {Pgv_dttabel} {Pgv_barang} {Ptkdjwbstr1}

MAP(mtbdKat)
tbdkode         tkdjwbstr1         REPLACE

MAP(mtbdSin)
