IMAGE(tmptrans)

FIELD(tmptranst)
tkdjwbstr1  	ALLCAPS		INPUTRI 1	/* NOBUK */
tkdjwbstr2 	ALLCAPS	        INPUTRI 2	/* Tanngal */
lenter          NOCHANGE        INPUTRI 3

CALCS()
