cSAMSUNG        tkdjwbstr2 == "SAMSUNG"
cANDROID        tkdjwbstr2 != "APPLE" && tkdjwbstr2 != "SAMSUNG"

DEFAULTS(tmptranst)
lkatgadai30     INIT            KATGADAI30
lIPHONE         INIT            IPHONE
lSAMSUNG        INIT            SAMSUNG

EDITS(tmptranst)
