lSAMSUNG        tkdrek       REPLACE_IF cSAMSUNG
cBLANKS         tkdrek       DO_CALC_IF cANDROID

HOOKS(tmptranst)
AFTER_INPUT    cur_keybd=EN     DO_MAP mkatsoal

