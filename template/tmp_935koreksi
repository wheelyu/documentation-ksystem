lKORCEO		tkddata		REPLACE

CALCS()
ckuncibhnfinaldev		djoinabkbhnfindev  == 0 && lnipsendev  != BLANKS
ckuncibhnfinalhdev		djoinabkbhnfinhdev == 0 && lnipheaddev != BLANKS
ckuncibhnfinalhopr		djoinabkbhnfinhopr == 0 && lnipheadopr != BLANKS
ctglhmin3			tlmtgl - 3
cesokhari			g_tgltrn + 1
ctamdirmdrpeserta		tlmkodeapr == "RMDR_PESERTA"
ctipereminderpeserta		abktype == "RMDRPSRT"

cfartglmeet			tlmtgl - g_tgltrn > 2
cneartglmeet			tlmtgl - g_tgltrn <= 2
cpasdimin2			g_tgltrn == (tlmtgl - 2)
cpasdimin1			g_tgltrn == (tlmtgl - 1)

