	DBC_TARGET	abkdatbukidx lKUNCIABSEN tlmnobuk
	DBC_SELECT	cselbhnfinhdev

DBCALCS(djoinabkbhnfinhopr)
	DBC_COMMAND	JOIN
	DBC_TARGET	abkdatbukidx lKUNCIABSEN tlmnobuk
	DBC_SELECT	cselbhnfinhopr

