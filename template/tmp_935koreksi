gt_RINP			abksts		REPLACE_IF cpasdimin2		/*jika hari ini pas di H-2*/
gv_INPG			abksts		REPLACE_IF cpasdimin1		/*jika hari ini pas di H-1*/
cesokhari		abktgl		DO_CALC_IF cfartglmeet 		/*jika hari ini > H-2 dari tgl meeting*/
