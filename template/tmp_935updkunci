tkdnourt                PROTECT                         INPUTRI  1       /*no urut*/
tkdnobuk                PROTECT                         INPUTRI  2       /*Nobuk*/
tkdtgl                  PROTECT                         INPUTRI  3       /*tanggal input*/
tkdstr1                 PROTECT                         INPUTRI  4       /*nip penginput*/
lnamainput              PROTECT                         INPUTRI  5       /*nama penginput*/
tkdnoll                 NOCHANGE                        INPUTRI  6       /*jenis pica yang terkunci*/
tkdstr2                 PROTECT                         INPUTRI  7       /*ket jenis pica yang terkunci*/
tkdtgl2                 NONE {DD-MM-YYYY} NOLIMIT       INPUTRI  8       /*tgl mundur kuncian*/
tlmnoasal               PROTECT                         INPUTRI  9       /*status2 akhir master*/
lenter                  NOCHANGE                        INPUTRI 10

DEFAULTS(tmptranst)
lenter                  INIT_LABEL              "Enter Disini"  
tkdtgl                  INIT                    {g_tgltrn}
tkdstr1                 INIT                    {g_usrkode}
tkdnoll                 DFALT_SCAN_BLANKS       1  "UPLOAD BHN MEET"


EDITS(tmptranst)
e.Isi Jenis Pica                tkdnoll         MANDATORY
e.Isi Tanggal Mundur            tkdtgl2         MANDATORY
e.Validate                      tkdnobuk        VALIDATE tlmbukidx mvalidatekunci935 0
e.Sudah Pernah Mundur Pica      tkdnoll         DUPKEY tkddatbukll {PlUPDPICA935} {Ptlmnobuk}  

CALCS()
cjoinnamainput          djoinnamainput == 1
ctipesama               abkkym2 == tkdstr2 && (abksts == "INPG" || abksts == "RINP")
ctgllbhhrini            tkdtgl2 > g_tgltrn
cmaksmin3               (tlmtgl - tkdtgl2) >= 3
ctipe1                  tkdnoll == "1"


MAP(mmapinputmundur)
cnourt                  tkdnourt        DO_CALC
lnamainput              lnamainput      REPLACE_IF cjoinnamainput

MAP(mvalidatekunci935)
tlmnobuk                tkdnobuk        REPLACE
lnamainput              lnamainput      REPLACE_IF cjoinnamainput

MAP(mmaptipekunci)
lketuplbhnmeet          tkdstr2         REPLACE_IF ctipe1

HOOKS(tmptranst)
AFTER_INPUT             cur_field=tkdstr1       DO_MAP SHOW mmapinputmundur

AFTER_INPUT             cur_field=tkdtgl2       DO_MAP SHOW
                        IF ctgllbhhrini         mdum
                        ELSE HKCURSOR
                        HKMSG Tanggal Harus Lebih Dari Hari Ini

AFTER_INPUT             cur_field=tkdtgl2       DO_MAP SHOW
                        IF cmaksmin3            mdum
                        ELSE HKCURSOR
                        HKMSG Maksimal Tanggal Mundur H-3

AFTER_INPUT             cur_field=tkdnoll     DO_MAP SHOW mmaptipekunci

