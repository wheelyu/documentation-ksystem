IMAGE(tmptranst)
/---------------------------------------------------------------------------------\
|t.TanggungJawab                                                                  |
|/------------t---------------------------------t--------------------------------\|
||t.Jabatan   |t.TanggungJawab                  |t.IndikatorKerja                ||
|\------------.---------------------------------.--------------------------------/|
\---------------------------------------------------------------------------------/

IMAGE(tmptrans)
!|____________|_________________________________|_________________________________|

FIELD(tmptrans)
spknobuk    PROTECT        INPUTRI         1
spknote     TEXTAREA PROTECT                INPUTRI         2
lindkerja   TEXTAREA PROTECT                INPUTRI         3

CALCS()
cselspkjobdesc         lspkjrk==spkjrk

MAP(mjoinspkindkerja)
spknote     lindkerja       REPLACE

DBCALCS(djoinspkindkerja)
        DBC_COMMAND     JOIN
        DBC_TARGET      spkdatbuktyp   lDTJOBDESC tbdkode lJD03
        DBC_SELECT      cselspkjobdesc
        DBC_MAP         mjoinspkindkerja

CALCS()
cdettanggungjwb tmpkode=="TANGGUNGJWB"
cjoinspkindkerja    djoinspkindkerja==1

EDIT(tmptrans)
e.Validate spknobuk VALIDATE tbddatkodidx mtbdjabtgngjwb 0 {Pgv_dttabel} {Pgv_personal} {Pgv_jabatan} 

MAP(mtbdjabtgngjwb)
tbdkode     spknobuk    REPLACE
spkjrk      lspkjrk     REPLACE
lindkerja   lindkerja   REPLACE_IF cjoinspkindkerja


SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_SORT_BY_FIELD spkjrk
SFL_COND    cdettanggungjwb

SFL_LINES(6)        /* Jml record yang kelihatan di layar */
SFL_TARGET
spkdatbuktyp   lDTJOBDESC tbdkode lJD02 