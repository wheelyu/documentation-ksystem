MAP(mmapmaptlddet)
tlddvs  laccblast REPLACE
tldcab  laccfucall REPLACE
tldtydis ltldtydis      REPLACE
CALCS()
chm2 (tkmtgl1 + 2 == tkmtgl && tkmplg != g_usrkode) || tkmplg == g_usrkode
chm1 (tkmtgl1 + 1 == tkmtgl && tkmplg != g_usrkode )|| tkmplg == g_usrkode

chm2nip (tkmtgl1 + 2 == tkmtgl && tkmplg != g_usrkode)
chm1nip (tkmtgl1 + 1 == tkmtgl && tkmplg != g_usrkode )
cupdminatT tldtydis == "T"
cbisaIsiDet tkmtgl >= tkmtgl1 + 1 && tldstr1 == "Y"
cuplfoto (tkmtgl1 + 1 == tkmtgl || tkmtgl1 + 2 == tkmtgl)

cbisaUdet (tkmplg == g_usrkode) || (djoinamtatasan12 == 1 && lamtstr1 == g_usrkode) || g_grpnam == "RI"
MAP(mupdtlddet)
laccblast tlddvs REPLACE
laccfucall tldcab   REPLACE
ltldtydis  tldtydis     REPLACE
g_usrkode tldukrwrn REPLACE_IF chm1nip 
g_usrkode tldnobbm REPLACE_IF chm2nip
lT      tldstr1 REPLACE_IF cupdminatT

DBCALCS(dupdtlda1)
        DBC_COMMAND     UPDATE
        DBC_TARGET      tldprmidx   tldprm
        DBC_MAP         mupdtlda1

DBCALCS(dupdtlda2)
