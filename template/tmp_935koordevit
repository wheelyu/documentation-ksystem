IMAGE(tmptrans)

FIELDS(tmptranst)
spknobuk                        PROTECT                         INPUTRI 1       /*Nobuk*/
spktglft                        PROTECT {DD-MM-YYYY}            INPUTRI 2       /*Tanggal Pelaksaaan*/
spktgg                          NONE                            INPUTRI 3       /*Judul Koordinasi*/
spkreview                       TEXTAREA                        INPUTRI 4       /*Ket Koordinasi*/
spktglft2                       NOLIMIT {DD-MM-YYYY}            INPUTRI 5       /*Tgl Reschedule*/
spkhasil                        PROTECT                         INPUTRI 6       /*Tanda Upload Dev*/
spktglft3                       PROTECT {DD-MM-YYYY}            INPUTRI 7       /*Tgl Upload*/
spkhasil2                       PROTECT                         INPUTRI 8       /*Tanda Upload IT*/
spkreview2                      TEXTAREA                        INPUTRI 9       /*Keterangan*/
lenter                          NOCHANGE                        INPUTRI 10      /*Enter*/

CALCS()
cmundurhmin8                   ((tlmtgl - spktglft2) >= 8) || spktglft2 == 0
cadatglreschkoor               spktglft2 != 0 && g_tgltrn != spktglft2
ckuncikoorbhnmeet              abktype == "KOORMEET"

DEFAULTS(tmptranst)
lenter                          INIT_LABEL                      "Enter Disini"

MAP(misikordevit)
tlmnobuk        spknobuk        REPLACE
g_tgltrn        spktglft        REPLACE
lUPLDEV         spkfoto         REPLACE
lUPLIT          spkfoto2        REPLACE
cBLANKS         spktglft2       DO_CALC

HOOKS(tmptranst)
BEFORE_INPUT                    cur_field=spktgg                DO_MAP SHOW misikordevit    
AFTER_INPUT                     cur_field=spktglft2             DO_MAP SHOW
                                IF cmundurhmin8                 mdum
                                ELSE HKCURSOR STAY
                                HKMSG Hanya Bisa Mundur ke H-8 dari Tanggal Meeting


MAP(mupdtandauploaddev)
lOK             spkhasil        REPLACE
g_tgltrn        spktglft4       REPLACE
DBCALCS(dupduploaddev)
        DBC_COMMAND             UPDATE
        DBC_TARGET              spkprmidx spkprm
        DBC_MAP                 mupdtandauploaddev

MAP(mupdtandauploadit)
lOK             spkhasil2       REPLACE
g_tgltrn        spktglft3       REPLACE
DBCALCS(dupduploadit)
        DBC_COMMAND             UPDATE
        DBC_TARGET              spkprmidx spkprm
        DBC_MAP                 mupdtandauploadit

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_SHOW_NEXT
SFL_UPL_DIRFLD          tlmtgl
SFL_DOCUPLFLD           spknobuk spkfoto 
SFL_UPLFLD              spknobuk spkfoto2
SFL_DOCUPLFLD_DBCALCS   dupduploaddev   /*tanda upload DEV*/
SFL_UPLFLD_DBCALCS      dupduploadit    /*tanda upload IT*/
SFL_DOCUPL_DELCOND      c0
SFL_TARGET	spkdatbuktyp    lKORDEVIT tlmnobuk

SFL_MAP
lKORDEVIT       spkdata


MAP(mundurkuncihmin8)
spktglft2               abktgl          REPLACE_IF ckuncikoorbhnmeet
gt_RINP                 abksts          REPLACE_IF ckuncikoorbhnmeet

SPCALCS(spaddkoordevit)
DO_LIB_IF cadatglreschkoor          ap_dbclc(DNAME dundurkuncihmin8,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN tlmnobuk,DMAP mundurkuncihmin8);

POSTING(tmptrans)
PST_ADDCMD      spaddkoordevit
PST_UPDCMD      spaddkoordevit