IMAGE(tmptrans)

FIELD(tmptranst)
tldbrg              ALLCAPS                     INPUTRI         1
tldhrg              DIGITS SCROLL QNONMANDATORY INPUTRI         1 /*Nominal harga*/
tldkat              ALLCAPS                     INPUTRI         2 /*Status Gedung*/
tldperdis1          DIGITS SCROLL               INPUTRI         3 /*Jumlah Lantai*/
tldperdis2          NUMERIC SCROLL              INPUTRI         4 /*Panjang Bangunan*/
tldperdis3          NUMERIC SCROLL              INPUTRI         5 /*Lebar Bangunan*/
tldperdis4          NUMERIC SCROLL              INPUTRI         6 /*Tinggi Bangunan*/
tldperdis5          DIGITS SCROLL               INPUTRI         7 /*Jumlah Kamar*/
tldperdis6          DIGITS SCROLL               INPUTRI         8 /*Jumlah Toilet*/
tldperdis7          NUMERIC SCROLL              INPUTRI         9 /*Tegangan Listrik*/
tldstr1             ALLCAPS                     INPUTRI         10 /*Air*/
tldsat              ALLCAPS                     INPUTRI         11 /*Layak/Tidak*/
tldket              TEXTAREA                    INPUTRI         12 /*Keterangan kelayakan*/
lenter              NOCHANGE                    INPUTRI         13

DEFAULTS(tmptranst)
tldsat          DFALT_SCAN      BLANKS
                                LAYAK
                                TIDAK_LAYAK
lenter          INIT        "Enter"

EDITS(tmptranst)
e.Mandatory     tldhrg      MANDATORY
e.Mandatory     tldkat      MANDATORY
e.Mandatory     tldperdis1      MANDATORY
e.Mandatory     tldperdis2      MANDATORY
e.Mandatory     tldperdis3      MANDATORY
e.Mandatory     tldperdis4      MANDATORY
e.Mandatory     tldperdis7      MANDATORY
e.Mandatory     tldstr1      MANDATORY
e.Mandatory     tldsat      MANDATORY
e.Mandatory     tldket      MANDATORY_IF ctdklayak
e.ValidateStsGedung tldkat      VALIDATE tbtdattypkod mtbtstsgedung stbtstsgedung {Pgv_dttabel} {Pgv_dttabel21} {PlDTGADAI} {PlSTSGEDUNG} {PlSTATUS}
e.ValidateStsAir    tldstr1     VALIDATE tbtdattypkod mtbtair stbtstsgedung {Pgv_dttabel} {Pgv_dttabel21} {PlDTGADAI} {PlSTSGEDUNG} {PlAIR}

HOOKS(tmptranst)
BEFORE_INPUT    cur_field=tldket    DO_SKIP_IF clayak
AFTER_INPUT     cur_field=tldket    DO_MAP mket /* Setelah input di field keterangan, lakukan mapping untuk menghitung panjang karakter keterangan */
AFTER_INPUT     cur_field=tldket    DO_MAP SHOW
                                    IF cpanjangminket mket
                                    ELSE HKCURSOR STAY 
                                    HKMSG t.Min25Karakter

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_SHOW_NEXT
SFL_SELECT cINFOGED
SFL_TARGET
    tldbukurtidx tlmnobuk 
SFL_MAP
    lINFOGED    tlddata     REPLACE
    tlmnobuk    tldnobuk    REPLACE
