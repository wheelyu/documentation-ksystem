IMAGE(tmptrans)

FIELD(tmptranst)
tldsat                  PROTECT                 INPUTRI         1
tldtydis                NOCHANGE                INPUTRI         2
tldket                  TEXTAREA                INPUTRI         3
tldgrup                 NOCHANGE                INPUTRI         4
tldket2                 TEXTAREA                INPUTRI         5
lenter                  NOCHANGE                INPUTRI         6

DEFAULTS(tmptranst)
tldtydis          DFALT_SCAN            BLANKS
                                        SDH
                                        BLM
tldgrup           DFALT_SCAN            BLANKS
                                        SDH
                                        BLM
CALCS()
cusrsdh     ((g_usrkode == tlmkode || g_grpnam == "PICGADAI") && tldtydis == "SDH") || (g_grpnam == "SPVGADAI" || g_grpnam == "ASSTMGR" || g_grpnam == "RMGADAI" || g_grpnam == "IT" || g_grpnam == "RI")
cusrblm     ((g_usrkode == tlmkode || g_grpnam == "PICGADAI") && tldtydis == "BLM") 
cspvsdh     ((g_grpnam == "SPVGADAI" || g_grpnam == "ASSTMGR" || g_grpnam == "RMGADAI" || g_grpnam == "IT" || g_grpnam == "RI") && tldgrup == "SDH") || g_usrkode ==tlmkode
cspvblm     (g_grpnam == "SPVGADAI" || g_grpnam == "ASSTMGR" || g_grpnam == "RMGADAI" || g_grpnam == "IT" || g_grpnam == "RI") && tldgrup == "BLM"
cpjgket     DO_LIB     ap_strln(tldket, &lpjgket);
cpjgket2x     DO_LIB     ap_strln(tldket2, &lpjgket2x);
cmin25charx (g_usrkode != tlmkode || g_grpnam == "PICGADAI") || (tldtydis == "SDH") || (tldtydis == "BLM" && lpjgket >= 25)
cmin25chary (g_usrkode == tlmkode || g_grpnam == "PICGADAI") || (tldgrup == "SDH") || (tldgrup == "BLM" && lpjgket2x >= 25)

MAP(mket)
cpjgket		lpjgket	DO_CALC

MAP(mket2x)
cpjgket2x       lpjgket2x	DO_CALC

EDITS(tmptranst)
e.Mandatory     tldtydis    MANDATORY_IF cuser
e.Mandatory     tldket      MANDATORY_IF cusrblm
e.Mandatory     tldgrup     MANDATORY_IF cspvats
e.Mandatory     tldket2     MANDATORY_IF cspvblm

HOOKS(tmptranst)
BEFORE_INPUT     cur_field=tldtydis    DO_SKIP_IF cspvats
BEFORE_INPUT     cur_field=tldket      DO_SKIP_IF cusrsdh
BEFORE_INPUT     cur_field=tldgrup     DO_SKIP_IF cuser
BEFORE_INPUT     cur_field=tldket2     DO_SKIP_IF cspvsdh
AFTER_INPUT     cur_field=tldket       DO_MAP SHOW mket
AFTER_INPUT     cur_field=tldket       DO_MAP SHOW
                                        IF  cmin25charx mdum
                                        ELSE HKCURSOR STAY
                                        HKMSG t.KeteranganMin25Karakaterx
AFTER_INPUT     cur_field=tldket2       DO_MAP SHOW mket2x
AFTER_INPUT     cur_field=tldket2       DO_MAP SHOW
                                        IF  cmin25chary mdum
                                        ELSE HKCURSOR STAY
                                        HKMSG t.KeteranganMin25Karakater


SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_SHOW_NEXT
