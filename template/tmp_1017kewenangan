IMAGE(tmptranst)
/---------------------------------------------------------------------------------\
|t.Kewenangan                                                                     |
|/------------t---------------------------------t--------------------------------\|
||t.Jabatan   |t.Rekomendasi                    |t.PegambilKeputusan             ||
|\------------.---------------------------------.--------------------------------/|
\---------------------------------------------------------------------------------/

IMAGE(tmptrans)
!|____________|_________________________________|_________________________________|
FIELD(tmptrans)
spknobuk    PROTECT        INPUTRI         1
spknote     TEXTAREA PROTECT                INPUTRI         2
lpengputusan    TEXTAREA    PROTECT         INPUTRI         3


MAP(mjoinspkkeputusan)
spknote     lpengputusan       REPLACE

DBCALCS(djoinspkkeputusan)
        DBC_COMMAND     JOIN
        DBC_TARGET      spkdatbuktyp   lDTJOBDESC tbdkode lJD09
        DBC_SELECT      cselspkjobdesc
        DBC_MAP         mjoinspkkeputusan


CALCS()
cdetkewenangan tmpkode=="KEWENANGAN"
cjoinspkkeputusan    djoinspkkeputusan==1

EDIT(tmptrans)
e.Validate spknobuk VALIDATE tbddatkodidx mtbdjabkew 0 {Pgv_dttabel} {Pgv_personal} {Pgv_jabatan} 

MAP(mtbdjabkew)
tbdkode     spknobuk    REPLACE
spkjrk      lspkjrk     REPLACE
lpengputusan   lpengputusan   REPLACE_IF cjoinspkkeputusan

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)
SFL_SORT_BY_FIELD spkjrk
SFL_COND    cdetkewenangan

SFL_LINES(6)        /* Jml record yang kelihatan di layar */
SFL_TARGET
spkdatbuktyp   lDTJOBDESC tbdkode lJD08 