LOCAL
PGM_FIELDS
ltipe		STRING	21
lbtmnobuk21	STRING	21
lbtmsoa		STRING	21
lbtmiklan	STRING	21
lnofak		STRING	21
lbtmscr		STRING  11	
lstspk1		STRING	5
lstspk2		STRING	5
ltglpk		DATE	4

CALCS()
cbtmklik	btmdata == "BUKUTAMU" && btmsts == "CLSD" && (btmiklan == "KLIKNSS_RO" || btmiklan == "KLIKNSS_HO")
cppmaktif	ppmsts != "VOID" && ppmsts != "OPEN"
cKR			ppmstskrm == "KR"
c305		bkmscr == "305"

MAP(mjoinbtmpk)
btmnobuk	lbtmnobuk21	REPLACE
btmsoa		lbtmsoa		REPLACE
btmiklan	lbtmiklan	REPLACE
btmsts 		lstspk1		REPLACE
btmflag1	lstspk2		REPLACE
btmtgl		ltglpk		REPLACE
btmscr		lbtmscr		REPLACE

DBCALCS(djoinbtmklik)
	DBC_COMMAND	JOIN
	DBC_SELECT	cbtmklik
	DBC_TARGET	btmplgbukidx psmktp
	DBC_MAP		mjoinbtmpk

DBCALCS(djoinbtmpk)
	DBC_COMMAND	JOIN_LAST_SFL
	DBC_TARGET	btmplgbukidx psmktp
	DBC_MAP		mjoinbtmpk

IMAGE(tmptranst)
/-------------------------------------\
|i.Tipe      : ______________________ |
|t.NoPK      : ______________________ |
|i.Soa	     : ______________________ |
|i.Iklan     : ______________________ |
|i.Ktp       : ______________________ |
|t.NoFak     : ______________________ |
|t.StatusPK1 : ______________________ |
|t.StatusPK2 : ______________________ |
|t.Tanggal   : ______________________ |
\-------------------------------------/

IMAGE(tmptrans)

FIELD(tmptranst)
ltipe		PROTECT				INPUTRI 1
lbtmnobuk21	PROTECT				INPUTRI	2
lbtmsoa		PROTECT				INPUTRI	3
lbtmiklan	PROTECT				INPUTRI	4
psmktp		PROTECT				INPUTRI	5
lnofak		PROTECT 			INPUTRI 6
lstspk1		PROTECT 			INPUTRI 7
lstspk2		PROTECT 			INPUTRI 8
ltglpk		PROTECT {DD-MM-YY}	INPUTRI 9

MAP(mjoinppm)
ppmnobuk	lnofak		REPLACE_IF cKR

MAP(mjoinbkm)
bkmnobuk	lnofak		REPLACE_IF c305

DBCALCS(djoinppm)
	DBC_COMMAND	JOIN
	DBC_TARGET	ppmnollidx	lbtmnobuk21
	DBC_SELECT	cppmaktif
	DBC_MAP		mjoinppm

DBCALCS(djoinbkm)
    DBC_COMMAND     JOIN
    DBC_TARGET      bkmdatbsstke lbkmdata lbtmnobuk21 gv_CLSD
    DBC_MAP         mjoinbkm

CALCS()
cjoinbtmpk	(djoinbtmklik == 1 || (djoinbtmklik == 0 && djoinbtmpk == 1))
cfakhmc		lbtmscr=="610" && lbtmnobuk21 != BLANKS && djoinppm==1
cfakm2w		lbtmscr=="630" && lbtmnobuk21 != BLANKS && djoinbkm==1
cbukanklik	djoinbtmklik == 0
ciniklik	djoinbtmklik == 1
cALL		"ALL"
cKLIK		"KLIK"

EDITS(tmptranst)
e.Validate	psmktp		VALIDATE psmktpidx mpsmklik 0

MAP(mpsmklik)
psmktp		psmktp		REPLACE
g_strksg	lbtmnobuk21	REPLACE
g_strksg	lbtmsoa		REPLACE
g_strksg	lbtmiklan	REPLACE
g_strksg	lstspk1		REPLACE
g_strksg	lstspk2		REPLACE
g_strksg 	ltglpk		REPLACE
g_strksg	lnofak		REPLACE
lbtmnobuk21	lbtmnobuk21	REPLACE_IF cjoinbtmpk
lbtmsoa		lbtmsoa		REPLACE_IF cjoinbtmpk
lbtmiklan	lbtmiklan	REPLACE_IF cjoinbtmpk
lstspk1		lstspk1		REPLACE_IF cjoinbtmpk
lstspk2		lstspk2		REPLACE_IF cjoinbtmpk
ltglpk		ltglpk		REPLACE_IF cjoinbtmpk
lnofak		lnofak		REPLACE_IF cfakhmc
lnofak		lnofak		REPLACE_IF cfakm2w
cALL		ltipe		DO_CALC_IF cbukanklik
cKLIK		ltipe		DO_CALC_IF ciniklik

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_TARGET
	psmktpidx psmktp
