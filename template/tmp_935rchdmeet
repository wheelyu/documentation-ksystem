DO_LIB_IF creschkemin84		ap_dbclc(DNAME dbukasemuakunci935,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN tlmnobuk,DMAP mbukasemuakunci935);			/*buka semua kunci 935*/

DO_LIB_IF creschkemin8		ap_dbclc(DNAME daddkuncibahanmeetsendev8,DCOMMAND ADD,DFILE abk,DMAP maddabkuplbhnmeetsendev8);	
