IMAGE(tmptrans)

FIELDS(tmptranst)
spkkode				NOCHANGE			INPUTRI	1	/*Status Ubah*/
spktglft			PROTECT {DD-MM-YYYY}		INPUTRI	2	/*Tanggal Meeting*/
spktglft2			NOLIMIT {DD-MM-YYYY}		INPUTRI 3	/*Tanggal Reschedule*/
spkjam				NOCHANGE			INPUTRI	4	/*Waktu Mulai*/
spkjam2				NOCHANGE			INPUTRI	5	/*Waktu Selesai*/
spkkat				PROTECT				INPUTRI	6	/*Judul Meeting*/
spkkat2				NOCHANGE			INPUTRI	7	/*Tempat*/
spkket				TEXTAREA			INPUTRI	8	/*Keterangan Meeting*/
lenter				NOCHANGE			INPUTRI	9	/*Enter*/


CALCS()
cjikabatal			spkkode == "BATAL"
cjikagantitgl			spkkode == "GANTITGL"
/*cupdtglmeet			(spkkode == "GANTITGL" && spktglft2 > g_tgltrn) || spkkode == "BATAL"*/
creschkemin84			(spktglft2 - g_tgltrn) == 8 || (spktglft2 - g_tgltrn) == 4 
creschkemin8			(spktglft2 - g_tgltrn) == 8
creschkemin3			(spktglft2 - g_tgltrn) == 3
ctglmin3			spktglft2 - 3
ctglmin2			spktglft2 - 2

DEFAULTS(tmptranst)
lenter				INIT_LABEL		"Enter Disini"

spkkode				DFALT_SCAN_BLANKS	BATAL
							GANTITGL

IF cjikagantitgl spkjam     	DFALT_SCAN_BLANKS       083000 090000 100000 110000 130000 140000 150000 160000 170000
IF cjikagantitgl spkjam2    	DFALT_SCAN_BLANKS       090000 100000 110000 120000 130000 140000 150000 160000 170000 174500

spkkat2				DFALT_SCAN_BLANKS	ONLINE
							OFFLINE

EDITS(tmptranst)	
e.isi tanggal reschedule	spktglft2		MANDATORY_IF cjikagantitgl

MAP(misireschbatal)
tlmtgl 				spktglft		REPLACE_IF cjikabatal
tlmjam1				spkjam			REPLACE_IF cjikabatal
tlmjam2				spkjam2			REPLACE_IF cjikabatal
tlmdari				spkkat			REPLACE_IF cjikabatal	
tlmuntuk			spkkat2			REPLACE_IF cjikabatal
DEBUG ldum			ldum			REPLACE

MAP(misireschgantitgl)
tlmdari				spkkat			REPLACE
DEBUG ldum			ldum			REPLACE

HOOKS(tmptranst)
AFTER_INPUT			cur_field=spkkode	DO_MAP SHOW IF cjikabatal	misireschbatal
AFTER_INPUT			cur_field=spkkode	DO_MAP SHOW IF cjikagantitgl	misireschgantitgl

BEFORE_INPUT			cur_field=spkkode	DO_SKIP_IF cjikabatal
BEFORE_INPUT			cur_field=spktglft2	DO_SKIP_IF cjikabatal
BEFORE_INPUT			cur_field=spkjam	DO_SKIP_IF cjikabatal	
BEFORE_INPUT			cur_field=spkjam2	DO_SKIP_IF cjikabatal
BEFORE_INPUT			cur_field=spkkat	DO_SKIP_IF cjikabatal	
BEFORE_INPUT			cur_field=spkkat2	DO_SKIP_IF cjikabatal
/*
AFTER_INPUT			cur_field=spktglft2	DO_MAP SHOW
				IF cupdtglmeet		mdum
				ELSE HKCURSOR
				HKMSG Tanggal Tidak Boleh Kurang Dari Hari Ini
*/

SUBFILE(tmptrans)
SFL_LINES(1)
SFL_TITLE(tmptranst)
SFL_TARGET	spkdatbuktyp lRSCHMEET tlmnobuk

SFL_MAP
lRSCHMEET	spkdata		REPLACE
tlmnobuk	spknobuk	REPLACE

