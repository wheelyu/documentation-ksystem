lketuplbhnmeet		abkkym2		REPLACE
gt_RINP			abksts		REPLACE
ctglmin2		abktgl		DO_CALC
g_scrnumstr		abkscr		REPLACE
lUPBHNMET		abktype		REPLACE
DEBUG ldum		ldum		REPLACE

