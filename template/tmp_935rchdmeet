SPCALCS(spreschedule)
/******************** jika batal *********************/
DO_LIB_IF cjikabatal		ap_dbclc(DNAME dbatalmeeting,DCOMMAND UPDATE,DTARGET tlmprmidx tlmprm,DMAP mbatalmeeting);
DO_LIB_IF cjikabatal		ap_dbclc(DNAME dbukaabkbtlmeet,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN tlmnobuk,DMAP mbukaabkbtlmeet);			/*buka semua kunci 935*/

/******************** jika ganti tgl ****************/
