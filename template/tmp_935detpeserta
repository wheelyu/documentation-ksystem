CALCS()
cselkonfhdrpeserta	abkkym == tkdnoll  && abktype == "KONFHDR"

DBCALCS(djoinabkkonfhadir)
	DBC_COMMAND	JOIN
	DBC_TARGET	abkdatbukidx lKUNCIABSEN tlmnobuk
	DBC_SELECT	cselkonfhdrpeserta

IMAGE(tmptranst) 
/-----------t------------------t---------------------t----------t--------t-------\
| i.Nip     | i.Nama           | i.Jabatan           | t.enter  |        |       |
\-----------.------------------.---------------------.----------.--------.-------/

IMAGE(tmptrans) 
|___________|__________________|_____________________|__________|________|_______|

FIELD(tmptrans)
tkdnoll				ALLCAPS SCROLL			INPUTRI 1
lnamapeserta			ALLCAPS SCROLL			INPUTRI 2
ljabpeserta			ALLCAPS	SCROLL			INPUTRI	3
lenter				NOCHANGE			INPUTRI 5
ltombkonf			TOMBOL				INPUTRI 6
tkdstr1				PROTECT				INPUTRI 7

CALCS()
cupdkonf			g_curcmd == 2
cpeserta			(g_usrkode == tkdnoll || g_grpnam == "PDCA") && djoinabkkonfhadir == 1
cpesertax			(g_usrkode == tkdnoll || g_grpnam == "PDCA")
ckonfirhadir			abkkym == tkdnoll && abktype == "KONFHDR"

DEFAULTS(tmptrans)
lenter				INIT_LABEL		"Enter Disini"

EDITS(tmptrans)
e.Validate NIP	tkdnoll		VALIDATE psikodidx mpsi 0

MAP(mpsi)
psikode		tkdnoll		REPLACE
psinama		lnamapeserta	REPLACE
psijabatan	ljabpeserta	REPLACE

MAP(mupdkonfirhadir)
gv_CLSD		abksts		REPLACE_IF ckonfirhadir

MAP(mupdsdhkonf)
lOK		tkdstr1		REPLACE

SPCALCS(sptombkonf)
DO_LIB_IF cpeserta		ap_dbclc(DNAME dupdrmdrpsrt,DCOMMAND UPDATE_RANGE,DTARGET abkdatbukidx lKUNCIABSEN tlmnobuk,DMAP mupdkonfirhadir);
DO_LIB_IF cpesertax		ap_dbclc(DNAME dupdsdhkonf,DCOMMAND UPDATE,DTARGET tkdprmidx tkdprm,DMAP mupdsdhkonf);

HOOKS(tmptrans)
BEFORE_INPUT			cur_field=tkdnoll		DO_SKIP_IF cupdkonf
BEFORE_INPUT			cur_field=lnamapeserta		DO_SKIP_IF cupdkonf
BEFORE_INPUT			cur_field=ljabpeserta		DO_SKIP_IF cupdkonf

CLICKED				cur_field=ltombkonf		DO_SPCALCS sptombkonf

SUBFILE(tmptrans)
SFL_LINES(15)        
SFL_TITLE(tmptranst)
SFL_SHOW_NEXT
SFL_SORT_BY_FIELD tkdnourt
SFL_SORT_UPDOWN UP
SFL_TARGET
	tkddatbukll	lPESERTAMET   tlmnobuk

SFL_MAP
lPESERTAMET	tkddata
tlmnobuk	tkdnobuk