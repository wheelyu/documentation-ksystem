IMAGE(tmptrans)

FIELD(tmptranst)
tldket                  PROTECT                 INPUTRI         1
tldsat                  PROTECT                 INPUTRI         1
tldjml                  DIGITS                  INPUTRI         1
tldhrg                  DIGITS                  INPUTRI         2
tldkat                  PROTECT                 INPUTRI         2
tldtydis                NOCHANGE                INPUTRI         3
tldket2                 TEXTAREA                INPUTRI         4
lenter                  NOCHANGE                INPUTRI         5

DEFAULTS(tmptranst)
tldtydis        DFALT_SCAN              BLANKS
                                        ACC
                                        TACC

CALCS()
ctdklebih       tldhrg <= tldjml

EDITS(tmptranst)
e.Mandatory     tldjml          MANDATORY_IF cuser
e.Mandatory     tldhrg          MANDATORY_IF cuser
e.Mandatory     tldtydis        MANDATORY_IF cspvats
e.Mandatory     tldket2         MANDATORY_IF cspvats

HOOKS(tmptranst)
BEFORE_INPUT    cur_field=tldjml        DO_SKIP_IF cspvats
BEFORE_INPUT    cur_field=tldhrg        DO_SKIP_IF cspvats
BEFORE_INPUT    cur_field=tldtydis      DO_SKIP_IF cuser
BEFORE_INPUT    cur_field=tldket2       DO_SKIP_IF cspvusry
AFTER_INPUT     cur_field=tldhrg        DO_MAP SHOW
			                IF ctdklebih	mdum
			                ELSE HKCURSOR STAY
			                HKMSG Jumlah CCTV AKTIF MELEBIHI JUMLAH CCTV YG ADA
