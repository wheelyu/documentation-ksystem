IMAGE(tmptranst)
/-----------------------------------------------------------------------------------\
|t.JadwalRevSdm                                                                     |
| t.TanggalRev      _______________                                                 |
| t.KonfHadirSdm    _______________                                                 |
\-----------------------------------------------------------------------------------/



IMAGE(tmptrans)




FIELD(tmptranst)
tldtglfak      ALLCAPS NOLIMIT {DD-MM-YYYY}     INPUTRI 1
tldstr1        NOCHANGE     INPUTRI 2

CALCS()
cbknatasan      g_usrkode!=tlmdari && g_usrkode!="2492032"
cbknsdm         g_usrkode!=tlmplg && g_usrkode!="2492032"
ctglawlbln      DO_LIB ap_awlbl(tlmtgl,&ltglawlbln);
ctglawlm2       DO_LIB ap_tambl(ltglawlbln,l2,&ltglawlm2);
ctgl3m2         DO_LIB ap_jtpkr(ltipe1,ltglawlm2,l3,&ltgl3m2);
ctgl7m2         DO_LIB ap_jtpkr(ltipe1,ltglawlm2,l7,&ltgl7m2);
ctglawlm3       DO_LIB ap_tambl(ltglawlbln,l3,&ltglawlm3);
ctgl3m3         DO_LIB ap_jtpkr(ltipe1,ltglawlm3,l3,&ltgl3m3);
ctgl7m3         DO_LIB ap_jtpkr(ltipe1,ltglawlm3,l7,&ltgl7m3);
ctglrevojt1     (tldtglfak>=ltgl3m2 && tldtglfak<=ltgl7m2) || tlmtype2!="OJT1"
ctglrevojt2     (tldtglfak>=ltgl3m3 && tldtglfak<=ltgl7m3) || tlmtype2!="OJT2"


DEFAULT(tmptranst)
tldstr1         DFALT_SCAN_BLANKS   Y

MAP(misitpkonfrev)
c1      tldhrg      DO_CALC_IF csaatojt1  
c2      tldhrg      DO_CALC_IF csaatojt2

MAP(mhittgl)
ctglawlbln      ltglawlbln      DO_CALC
ctglawlm2       ltglawlm2       DO_CALC
ctgl3m2         ltgl3m2         DO_CALC
ctgl7m2         ltgl7m2         DO_CALC
ctglawlm3       ltglawlm3       DO_CALC
ctgl3m3         ltgl3m3         DO_CALC
ctgl7m3         ltgl7m3         DO_CALC

HOOKS(tmptranst)

BEFORE_INPUT    cur_field=tldtglfak DO_SKIP_IF cbknatasan
BEFORE_INPUT    cur_field=tldstr1   DO_SKIP_IF cbknsdm
BEFORE_INPUT     cur_field=tldtglfak DO_MAP SHOW mhittgl
AFTER_INPUT     cur_keybd=EN DO_MAP SHOW misitpkonfrev

AFTER_INPUT	cur_field=tldtglfak	DO_MAP SHOW 
        IF ctglrevojt1 mdum
        ELSE HKCURSOR STAY
        HKMSG HANYA BOLEH H+1 - H+7 M2

AFTER_INPUT	cur_field=tldtglfak	DO_MAP SHOW 
        IF ctglrevojt2 mdum
        ELSE HKCURSOR STAY
        HKMSG HANYA BOLEH H+3 - H+7 M3


CALCS()
cdetkonrev      (tlmtype2=="OJT1" || tlmtype2=="OJT2") && g_tgltrn>=tlmtgl2

SUBFILE(tmptrans)
SFL_TITLE(tmptranst)

SFL_LINES(1)        /* Jml record yang kelihatan di layar */
SFL_COND    cdetkonrev
SFL_SELECT  cseldetrev

SFL_TARGET
tldstsbrgukr   tlmdata gv_OPEN tlmnobuk lKONFREV

SFL_MAP
tlmdata     tlddata     REPLACE
tlmnobuk    tldnobuk    REPLACE
tlmnobuk    tldbrg      REPLACE
gv_OPEN     tldsts      REPLACE
lKONFREV   tldukrwrn   REPLACE


